generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String?
  emailVerified       DateTime?
  createdAt           DateTime  @default(now())
  lastLoginAt         DateTime?
  lastActivityAt      DateTime  @default(now())
  inactiveAt          DateTime?
  inactivityWarningAt DateTime?
  deletionRequestedAt DateTime?

  trips Trip[]

  @@index([lastActivityAt])
}

model Trip {
  id            Int      @id @default(autoincrement())
  tripName      String
  tripType      String
  startDate     DateTime
  endDate       DateTime
  travelerCount Int

  isPublished Boolean @default(false)
  shareToken  String? @unique

  description             String  @default("")
  notes                   String  @default("")
  destination             String  @default("")
  startLocation           String  @default("")
  tripSummary             Json?

  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  draftReminderAt   DateTime?
  travelerViewCount Int       @default(0)
  qrScanCount       Int       @default(0)

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  itineraryItems ItineraryItem[]
  travelSegments TravelSegment[]
  documents      TripDocument[]
  photos         TripPhoto[]
  updates        TripUpdate[]
  polls          Poll[]

  @@index([lastActivityAt])
  @@index([endDate])
}

model AccountDeletionAudit {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  reason    String
  deletedAt DateTime @default(now())

  @@index([deletedAt])
}

model BackupRun {
  id          Int       @id @default(autoincrement())
  status      String
  objectKey   String?
  size        Int?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([startedAt])
}

model ItineraryItem {
  id                    Int          @id @default(autoincrement())
  date                  DateTime
  time                  String
  title                 String
  description           String       @default("")
  createdAt             DateTime     @default(now())
  sourceTravelSegmentId Int?
  tripId                Int
  trip                  Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  linkedUpdates         TripUpdate[]

  @@index([sourceTravelSegmentId])
}

model TravelSegment {
  id            Int          @id @default(autoincrement())
  type          String
  title         String
  description   String       @default("")
  date          DateTime?
  time          String?
  startLocation String       @default("")
  destination   String       @default("")
  direction     String       @default("ONE_WAY")
  returnForSegmentId Int?
  position      Int          @default(0)
  autoGenerated Boolean      @default(false)
  createdAt     DateTime     @default(now())
  tripId        Int
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  linkedUpdates TripUpdate[]

  @@index([tripId, position])
  @@index([returnForSegmentId])
}

model TripDocument {
  id        Int      @id @default(autoincrement())
  name      String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripPhoto {
  id        Int      @id @default(autoincrement())
  name      String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripUpdate {
  id                    Int            @id @default(autoincrement())
  title                 String
  content               String
  updateType            String         @default("GENERAL")
  updateKind            String         @default("INFORMATIONAL")
  originalDate          DateTime?
  originalTime          String?
  newDate               DateTime?
  newTime               String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  tripId                Int
  trip                  Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelSegmentId       Int?
  sourceTravelSegmentId Int?
  travelSegment         TravelSegment? @relation(fields: [travelSegmentId], references: [id], onDelete: SetNull)
  itineraryItemId       Int?
  itineraryItem         ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([travelSegmentId])
  @@index([sourceTravelSegmentId])
  @@index([itineraryItemId])
}

model Poll {
  id        Int          @id @default(autoincrement())
  question  String
  isClosed  Boolean      @default(false)
  createdAt DateTime     @default(now())
  tripId    Int
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]

  @@index([tripId, createdAt])
}

model PollOption {
  id     Int        @id @default(autoincrement())
  label  String
  pollId Int
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id        Int        @id @default(autoincrement())
  voterId   String
  createdAt DateTime   @default(now())
  pollId    Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  Int
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@index([optionId])
}
