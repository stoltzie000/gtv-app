generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String?
  emailVerified       DateTime?
  createdAt           DateTime  @default(now())
  lastLoginAt         DateTime?
  lastActivityAt      DateTime  @default(now())
  inactiveAt          DateTime?
  inactivityWarningAt DateTime?
  deletionRequestedAt DateTime?

  trips Trip[]

  @@index([lastActivityAt])
}

model Trip {
  id            Int      @id @default(autoincrement())
  tripName      String
  tripType      String
  startDate     DateTime
  endDate       DateTime
  travelerCount Int

  status      String  @default("Not Started")
  isPublished Boolean @default(false)
  shareToken  String? @unique

  description             String  @default("")
  notes                   String  @default("")
  destination             String  @default("")
  startLocation           String  @default("")
  tripDirection           String?
  returnNeedsRegeneration Boolean @default(false)

  overviewStatus  String @default("Not Started")
  itineraryStatus String @default("Not Started")
  travelStatus    String @default("Not Started")
  documentsStatus String @default("Not Started")
  photosStatus    String @default("Not Started")

  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  draftReminderAt   DateTime?
  travelerViewCount Int       @default(0)
  qrScanCount       Int       @default(0)

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  itineraryItems ItineraryItem[]
  travelSegments TravelSegment[]
  documents      TripDocument[]
  photos         TripPhoto[]
  updates        TripUpdate[]
  polls          Poll[]

  @@index([lastActivityAt])
  @@index([endDate])
}

model AccountDeletionAudit {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  reason    String
  deletedAt DateTime @default(now())

  @@index([deletedAt])
}

model BackupRun {
  id          Int       @id @default(autoincrement())
  status      String
  objectKey   String?
  size        Int?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([startedAt])
}

model ItineraryItem {
  id          Int      @id @default(autoincrement())
  date        DateTime
  time        String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  tripId      Int
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TravelSegment {
  id            Int       @id @default(autoincrement())
  type          String
  title         String
  description   String    @default("")
  date          DateTime?
  time          String?
  startLocation String    @default("")
  destination   String    @default("")
  journey       String    @default("OUTBOUND")
  position      Int       @default(0)
  autoGenerated Boolean   @default(false)
  createdAt     DateTime  @default(now())
  tripId        Int
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, journey, position])
}

model TripDocument {
  id        Int      @id @default(autoincrement())
  name      String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripPhoto {
  id        Int      @id @default(autoincrement())
  name      String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripUpdate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model Poll {
  id        Int          @id @default(autoincrement())
  question  String
  isClosed  Boolean      @default(false)
  createdAt DateTime     @default(now())
  tripId    Int
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]

  @@index([tripId, createdAt])
}

model PollOption {
  id     Int        @id @default(autoincrement())
  label  String
  pollId Int
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id        Int        @id @default(autoincrement())
  voterId   String
  createdAt DateTime   @default(now())
  pollId    Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  Int
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@index([optionId])
}
