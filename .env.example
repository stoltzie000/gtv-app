DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAILS="admin@example.com"
CRON_SECRET="replace-with-a-long-random-secret"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM="GTV <no-reply@example.com>"
BACKUP_S3_BUCKET="gtv-backups"
BACKUP_S3_REGION="us-east-1"
BACKUP_S3_ACCESS_KEY_ID="access-key"
BACKUP_S3_SECRET_ACCESS_KEY="secret-key"
# Optional for S3-compatible providers such as Cloudflare R2 or MinIO.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_FORCE_PATH_STYLE="false"
